{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_FLOW_V3_ENABLED": "true",
    "CLAUDE_FLOW_HOOKS_ENABLED": "true",
    "CLAUDE_FLOW_MCP_TOOLS": "memory,swarm,agent,hooks",
    "ECC_DISABLED_HOOKS": "pre:edit-write:gateguard-fact-force,pre:bash:gateguard-fact-force,pre:config-protection",
    "GATEGUARD_BASH_ROUTINE_DISABLED": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npx @claude-flow*)",
      "Bash(npx claude-flow*)",
      "Bash(node .claude/*)",
      "mcp__claude-flow__*",
      "Bash(*codeagent-wrapper*)",
      "Bash(set-terminal-title \"Forge WebUI\" \"Ruflo Loop Worker\")",
      "PowerShell(pwsh -NoProfile -ExecutionPolicy Bypass -File \"C:\\\\Users\\\\JeremyWilliams\\\\.claude\\\\plugins\\\\cache\\\\2389-research\\\\terminal-title\\\\1.2.0\\\\skills\\\\scripts\\\\set_title.ps1\" \"Forge WebUI\" \"Ruflo Loop Worker\")",
      "PowerShell(npx @claude-flow/cli@latest hooks worker dispatch --trigger audit)"
    ],
    "defaultMode": "plan"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File C:/Users/JeremyWilliams/.claude/hooks/pre-commit-secret-scan.ps1"
          }
        ]
      },
      {
        "matcher": "Bash|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Users/JeremyWilliams/.claude/hooks/ccg/subagent-context.js",
            "timeout": 15000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Users/JeremyWilliams/.claude/hooks/ccg/workflow-state.js",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "node C:/Users/JeremyWilliams/.claude/hooks/ccg/skill-router.js",
            "timeout": 5000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Users/JeremyWilliams/.claude/hooks/ccg/session-start.js",
            "timeout": 15000
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "pwsh -NoProfile -File C:/Users/JeremyWilliams/.claude/statusline.ps1"
  },
